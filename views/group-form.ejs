<%- include('partials/header') %>
<h1>Create a study group</h1>

<% if (error) { %>
  <p class="error" role="alert"><%= error %></p>
<% } %>

<form class="group-form" method="post" action="/groups">
  <label>Group name
    <input type="text" name="name" value="<%= form.name %>" required>
  </label>
  <label>Course
    <select name="courseCode" required>
      <option value="">Select a course</option>
      <% courses.forEach((course) => { %>
        <option value="<%= course.code %>" <%= course.code === form.courseCode.trim().toUpperCase() ? 'selected' : '' %>><%= course.toString() %></option>
      <% }) %>
    </select>
  </label>
  <label>Maximum members
    <input type="text" name="capacity" inputmode="numeric" value="<%= form.capacity %>" required>
  </label>
  <label>Description
    <textarea name="description" rows="3" required><%= form.description %></textarea>
  </label>
  <label>Meeting time
    <input type="text" name="meetingTime" value="<%= form.meetingTime %>" placeholder="Mondays at 3 PM" required>
  </label>
  <label>Location
    <input type="text" name="location" value="<%= form.location %>" placeholder="Library room 204 or an online link" required>
  </label>
  <div class="actions">
    <button type="submit">Save</button>
    <a class="button secondary" href="/groups">Cancel</a>
  </div>
</form>
<%- include('partials/footer') %>
