{
  "name": "studyhub-web",
  "version": "1.0.0",
  "private": true,
  "description": "StudyHub campus study-group finder as a Node.js web application",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=20.19"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "author": "Moria El Akaya",
  "license": "UNLICENSED",
  "dependencies": {
    "ejs": "3.1.10",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "supertest": "7.3.2"
  }
}
